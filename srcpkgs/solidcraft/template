# Template file for 'solidcraft'
pkgname=solidcraft
version=0.51.2
revision=1
archs="x86_64* aarch64*"
build_style=cargo
make_build_args="-p solidcraft -p solidcraft-cli --no-default-features
 --features solidcraft/raytrace-cpu,solidcraft/bundled-render-library,solidcraft/profile,solidcraft-cli/raytrace-cpu,solidcraft-cli/profile"
hostmakedepends="pkg-config"
makedepends="libzstd-devel"
depends="libX11 libXcursor libXi libxkbcommon libxkbcommon-x11 wayland
 vulkan-loader libglvnd hicolor-icon-theme"
short_desc="Parametric 3D CAD application built in pure Rust"
maintainer="Filip Rojek <filip@filiprojek.cz>"
license="(MIT OR Apache-2.0) AND custom:SolidCraft-Brand"
homepage="https://solidcraft.io"
changelog="https://github.com/tangency-labs/solidcraft/releases"
distfiles="https://github.com/tangency-labs/solidcraft/archive/refs/tags/v${version}.tar.gz"
checksum=712e04a469cd1c8208aec0d0ef43c6777d80a08faf4c3bed31e6d548a0ae5bd7
# ~20 tests fail upstream too (tests/KNOWN_FAILING_TESTS) and the suite expects
# cargo nextest with its filter; plain cargo test also runs the slow tests
make_check=no

export ZSTD_SYS_USE_PKG_CONFIG=1
# The line tables upstream keeps for crash reports only cost memory and time here:
# xbps-src strips the binaries anyway
export CARGO_PROFILE_RELEASE_DEBUG=0

pre_build() {
	# The aarch64 cross build (thin LTO of several large crates at once) ran out of the CI
	# runner's 16 GB with one job per CPU. Set here: the rust build helper resets
	# CARGO_BUILD_JOBS to XBPS_MAKEJOBS after the template is read
	if [ "$CROSS_BUILD" ]; then
		export CARGO_BUILD_JOBS=2
		msg_normal "$pkgver: cross build with CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS\n"
	fi
}

do_install() {
	local _appid=io.tangencylabs.solidcraft _s

	vbin target/${RUST_TARGET}/release/solidcraft
	vbin target/${RUST_TARGET}/release/solidcraft-cli

	vinstall assets/platforms/linux/${_appid}.desktop 644 usr/share/applications
	vinstall assets/platforms/linux/${_appid}.mime.xml 644 usr/share/mime/packages ${_appid}.xml
	sed -e "s/@VERSION@/${version}/g" \
		-e "s/@DATE@/$(date -u -d @${SOURCE_DATE_EPOCH:-0} +%F)/g" \
		assets/platforms/linux/${_appid}.metainfo.xml.in > ${_appid}.metainfo.xml
	vinstall ${_appid}.metainfo.xml 644 usr/share/metainfo

	for _s in 16 24 32 48 64 128 256 512; do
		vinstall assets/icons/app/linux/exports/hicolor/${_s}x${_s}/apps/${_appid}.png 644 \
			usr/share/icons/hicolor/${_s}x${_s}/apps
	done

	vdoc README.md
	vdoc THIRD-PARTY-LICENSES.txt
	vlicense LICENSE-MIT
	vlicense LICENSE-BRAND
	vlicense NOTICE
}
